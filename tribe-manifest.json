{
  "serviceId": "servease",
  "name": "ServEase API Gateway",
  "serviceType": "tribe",
  "baseUrl": "https://api.servease.example",
  "healthCheck": "/health/ready",
  "version": "1.0.0",
  "requiredScopes": ["tribe:servease:read", "tribe:servease:write"],
  "exposes": [
    "/health/live",
    "/health/ready",
    "/v1/auth/register",
    "/v1/auth/password-reset",
    "/v1/auth/otp/generate",
    "/v1/auth/otp/verify",
    "/v1/auth/otp/:otpId/status",
    "/v1/auth/google/authorize",
    "/v1/me",
    "/v1/me/sessions",
    "/v1/me/two-factor/setup",
    "/v1/me/two-factor/verify",
    "/v1/me/preferences",
    "/v1/referrals",
    "/v1/geo/geocode",
    "/v1/geo/reverse-geocode",
    "/v1/geo/geofence",
    "/v1/catalog/categories",
    "/v1/catalog/services",
    "/v1/catalog/providers",
    "/v1/bookings",
    "/v1/bookings/:bookingId",
    "/v1/bookings/:bookingId/status",
    "/v1/bookings/:bookingId/timeline",
    "/v1/provider/availability",
    "/v1/provider/availability/:providerId",
    "/v1/conversations",
    "/v1/conversations/:conversationId/messages",
    "/v1/notifications",
    "/v1/notifications/:notificationId/read",
    "/v1/notifications/devices",
    "/v1/payments",
    "/v1/payments/:paymentId",
    "/v1/reviews",
    "/v1/support/tickets"
  ],
  "consumes": ["email", "sms", "geo", "payment", "otp", "gauth"]
}
