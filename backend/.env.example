# Gateway
PORT=5001
API_GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:19006
API_GATEWAY_RATE_LIMIT_MAX=120
API_GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# Service ports
AUTH_SERVICE_PORT=8501
USER_SERVICE_PORT=8502
CATALOG_SERVICE_PORT=8503
BOOKING_SERVICE_PORT=8504
AVAILABILITY_SERVICE_PORT=8505
MESSAGING_SERVICE_PORT=8506
PAYMENT_SERVICE_PORT=8507
REVIEW_SERVICE_PORT=8508
NOTIFICATION_SERVICE_PORT=8509
SUPPORT_SERVICE_PORT=8510
ADMIN_SERVICE_PORT=8511

# Internal service URLs used by the API Gateway
AUTH_SERVICE_URL=http://localhost:8501
USER_SERVICE_URL=http://localhost:8502
CATALOG_SERVICE_URL=http://localhost:8503
BOOKING_SERVICE_URL=http://localhost:8504
AVAILABILITY_SERVICE_URL=http://localhost:8505
MESSAGING_SERVICE_URL=http://localhost:8506
PAYMENT_SERVICE_URL=http://localhost:8507
REVIEW_SERVICE_URL=http://localhost:8508
NOTIFICATION_SERVICE_URL=http://localhost:8509
SUPPORT_SERVICE_URL=http://localhost:8510
ADMIN_SERVICE_URL=http://localhost:8511

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=servease-uploads
PASSWORD_RESET_REDIRECT_URL=servease://reset-password

# Optional APICenter shared-service probing for Admin > Integrations.
# Used to validate payment/email/sms/geo access through @implementsprint/sdk
# gateway contracts when testing supported integrations.
APICENTER_URL=
APICENTER_TRIBE_ID=
APICENTER_SERVICE_ID=
APICENTER_TRIBE_SECRET=
# Optional. Leave unset when operating APICenter payments through status polling only.
APICENTER_WEBHOOK_SECRET=
APICENTER_SMOKE_GAUTH_AUTHORIZE=false
APICENTER_SMOKE_GAUTH_REDIRECT_URI=https://servease.test/auth/google/callback
APICENTER_SMOKE_GEO_GEOCODE=false
APICENTER_SMOKE_GEO_ADDRESS=Manila, Philippines

# OpenRouteService directions for in-app provider navigation.
OPENROUTESERVICE_API_KEY=

# Optional scheduled admin report email worker.
ADMIN_REPORT_DELIVERY_WORKER_ENABLED=false
ADMIN_REPORT_DELIVERY_INTERVAL_MS=300000
ADMIN_REPORT_DOWNLOAD_BASE_URL=http://localhost:5001

# Optional demo seed overrides
DEMO_CUSTOMER_EMAIL=customer.demo@servease.test
DEMO_PROVIDER_EMAIL=provider.demo@servease.test
DEMO_ADMIN_EMAIL=admin.demo@servease.test
DEMO_ACCOUNT_PASSWORD="ServEaseDemo#2026"
