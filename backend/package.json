{
  "name": "@servease/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ServEase NestJS HTTP microservices backend",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n gateway,auth,user,catalog,booking,availability,messaging,payment,review,notification,support,admin \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:user\" \"npm:dev:catalog\" \"npm:dev:booking\" \"npm:dev:availability\" \"npm:dev:messaging\" \"npm:dev:payment\" \"npm:dev:review\" \"npm:dev:notification\" \"npm:dev:support\" \"npm:dev:admin\"",
    "dev:gateway": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/api-gateway/src/main.ts",
    "dev:auth": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/auth-service/src/main.ts",
    "dev:user": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/user-service/src/main.ts",
    "dev:catalog": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/catalog-service/src/main.ts",
    "dev:booking": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/booking-service/src/main.ts",
    "dev:availability": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/availability-service/src/main.ts",
    "dev:messaging": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/messaging-service/src/main.ts",
    "dev:payment": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/payment-service/src/main.ts",
    "dev:review": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/review-service/src/main.ts",
    "dev:notification": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/notification-service/src/main.ts",
    "dev:support": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/support-service/src/main.ts",
    "dev:admin": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/admin-service/src/main.ts",
    "start:gateway:dev": "npm run dev:gateway",
    "start:auth": "npm run dev:auth",
    "start:user": "npm run dev:user",
    "start:catalog": "npm run dev:catalog",
    "start:booking": "npm run dev:booking",
    "start:availability": "npm run dev:availability",
    "start:messaging": "npm run dev:messaging",
    "start:payment": "npm run dev:payment",
    "start:review": "npm run dev:review",
    "start:notification": "npm run dev:notification",
    "start:support": "npm run dev:support",
    "start:admin": "npm run dev:admin",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{apps,libs}/**/*.ts\"",
    "env:prod": "node scripts/check-production-env.mjs",
    "check:migrations": "node scripts/check-migration-drift.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm audit --omit=dev && npm run check:migrations && npm run smoke:all",
    "smoke:availability": "node scripts/smoke-availability.mjs",
    "smoke:apicenter": "node scripts/smoke-apicenter.mjs",
    "audit:apicenter-live": "node scripts/audit-apicenter-live.mjs",
    "verify:admin-apicenter-payment-sync": "node scripts/verify-admin-apicenter-payment-sync.mjs",
    "smoke:apicenter-webhook": "node scripts/smoke-apicenter-webhook.mjs",
    "smoke:booking": "node scripts/smoke-booking.mjs",
    "smoke:catalog": "node scripts/smoke-catalog.mjs",
    "smoke:demo": "node scripts/smoke-demo-data.mjs",
    "smoke:extended": "node scripts/smoke-extended-workflows.mjs",
    "smoke:health": "node scripts/smoke-health.mjs",
    "smoke:messaging": "node scripts/smoke-messaging.mjs",
    "smoke:all": "npm run smoke:apicenter && npm run smoke:apicenter-webhook && npm run smoke:v1-me && npm run smoke:catalog && npm run smoke:booking && npm run smoke:availability && npm run smoke:messaging && npm run smoke:extended && npm run seed:demo && npm run smoke:demo",
    "smoke:v1-me": "node scripts/smoke-v1-me.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "seed:mobile-production-like": "node scripts/seed-mobile-production-like-data.mjs",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@implementsprint/sdk": "1.2.1",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^16.4.7",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.21",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
