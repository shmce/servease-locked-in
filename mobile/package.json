{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "smoke:demo-api": "tsx scripts/smoke-demo-api.ts",
    "env:prod": "node scripts/check-production-env.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:cov": "node scripts/run-tests-with-coverage.mjs",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "detox test --configuration android.emu.debug",
    "perf:k6": "k6 run tests/performance/mobile-smoke.js",
    "lint:check": "expo lint",
    "lint": "expo lint"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "~19.1.0",
    "detox": "^20.50.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^30.4.2",
    "tsx": "^4.22.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "private": true
}
