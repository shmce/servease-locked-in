{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/servease-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/servease-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#56C490"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#56C490"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/servease-logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ServEase uses your photo library so providers can attach service progress photos."
        }
      ]
    ]
  }
}
